[Unit]
Description=COSMIC settings daemon (cosmic-config watchers)
Documentation=https://github.com/grigio/cosmalia-session
PartOf=cosmalia-session.target
After=cosmalia-session.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/cosmic-settings-daemon
Restart=on-failure
RestartSec=1
TimeoutStopSec=5
Slice=session.slice

# Started by cosmalia-session.target (Wants=), not enabled by the user.
