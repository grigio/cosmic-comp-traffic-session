#!/bin/sh
# cosmic-comp-traffic — minimal COSMIC session: the patched compositor
# Canonical source: ~/Code/cosmic-comp-traffic-session/files/usr/local/bin/
# (installed by scripts/install.sh; edit there, not in /usr/local/bin)
# (macOS traffic-light decorations, wlr-foreign-toplevel, 3-finger workspace
# swipe, in-process Alt+Tab) with Noctalia 5.3 as the shell.
# XDG session entry: /usr/share/wayland-sessions/cosmic-comp-traffic.desktop
# systemd user target: /usr/lib/systemd/user/cosmic-comp-traffic-session.target
#
# What runs, and nothing else:
#   cosmic-comp                     compositor
#   noctalia                        bar, dock, launcher, notifications,
#                                   lock screen, idle/suspend, polkit agent,
#                                   MPRIS, screensaver
#   xdg-desktop-portal + COSMIC impl (restarted below, see the comment)
# Already covered without starting anything here:
#   dbus-broker                     user bus
#   pipewire / wireplumber          socket + enabled unit (audio, screencast)
#   gnome-keyring-daemon            secret service, socket activated
#   gvfs-*, xdg-document-portal     D-Bus activated on first use
#   upower, power-profiles-daemon   system services, session agnostic

export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=cosmic-comp-traffic
# The ":COSMIC" entry is what makes xdg-desktop-portal pick the cosmic backend
# (its .portal file has UseIn=COSMIC). Without it only the gtk/wlr backends
# match and screenshots/screencast stop working.
export XDG_CURRENT_DESKTOP=cosmic-comp-traffic:COSMIC
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"

log="$XDG_RUNTIME_DIR/cosmic-comp-traffic.log"
: >"$log"   # per-session log; appending here grew forever across logins

say() { echo "cosmic-comp-traffic: $*" >>"$log"; }

# The cosmic-comp-traffic package provides /usr/bin/cosmic-comp (it conflicts
# with and replaces cosmic-comp), so the binary name is the stock one. Warn
# instead of refusing to log in if it was swapped back for the unpatched build:
# `pacman -S cosmic-comp` silently reverts the decorations.
if ! pacman -Qq cosmic-comp-traffic >/dev/null 2>&1; then
    say "warning: cosmic-comp-traffic is not installed, /usr/bin/cosmic-comp is unpatched"
    say "reinstall with ~/Code/cosmic-comp-traffic/scripts/install-latest.sh"
fi

# cosmic-comp picks its backend from the environment (src/backend/mod.rs):
# COSMIC_BACKEND wins; otherwise a set DISPLAY or WAYLAND_DISPLAY means
# "nested" (it tries x11, then winit) and only a clean environment means
# DRM/KMS. Leaving either set makes it try winit and die with
# "EventLoopCreation(NoCompositor)", so clear both.
if [ -z "${COSMIC_BACKEND:-}" ]; then
    unset WAYLAND_DISPLAY DISPLAY
fi

stamp="$XDG_RUNTIME_DIR/.cosmic-comp-traffic-start"
: >"$stamp"

cosmic-comp --no-xwayland &
comp_pid=$!

# On logout the session scope SIGTERMs this script, and even a plain
# "kill <script>" should not leave the shell and the portals behind.
cleanup() {
    if [ -n "${noctalia_pid:-}" ]; then
        kill "$noctalia_pid" 2>/dev/null
        noctalia_pid=""
    fi
    # cosmic-comp-traffic-session.target has BindsTo=graphical-session.target
    # and xdg-desktop-portal has PartOf=graphical-session.target, so this stops
    # them instead of leaving them with a stale WAYLAND_DISPLAY.
    systemctl --user --no-block stop graphical-session.target 2>/dev/null
}
trap 'cleanup; kill "$comp_pid" 2>/dev/null; exit 143' TERM INT HUP

# Find the socket cosmic-comp listens on (it picks wayland-N itself): Noctalia
# and everything it spawns has to be pointed at that one.
sock=""
i=0
while [ "$i" -lt 300 ] && kill -0 "$comp_pid" 2>/dev/null; do
    if command -v ss >/dev/null 2>&1; then
        sock=$(ss -xlHp 2>/dev/null |
            awk -v p="pid=$comp_pid," 'index($0, p) && $2 == "LISTEN" {print $5; exit}')
    else
        # no iproute2: newest socket created since the compositor started
        sock=$(find "$XDG_RUNTIME_DIR" -maxdepth 1 -name 'wayland-*' -type s \
            -newer "$stamp" -print -quit 2>/dev/null)
    fi
    if [ -n "$sock" ] && [ -S "$sock" ]; then
        break
    fi
    sock=""
    i=$((i + 1))
    sleep 0.1
done
rm -f "$stamp"

if [ -n "$sock" ]; then
    export WAYLAND_DISPLAY="${sock##*/}"

    # cosmic-comp was started without any display in its environment, so
    # publish ours for portals and other D-Bus/systemd-activated services.
    dbus-update-activation-environment --systemd \
        WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE \
        XDG_RUNTIME_DIR 2>/dev/null
    systemctl --user import-environment \
        WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE \
        XDG_RUNTIME_DIR 2>/dev/null

    # graphical-session.target is RefuseManualStart=yes: starting it directly
    # is silently refused. Start our own target instead, which pulls it in as
    # a dependency. Blocking, so units ordered After=graphical-session.target
    # (the portal backends) see a consistent state before Noctalia starts.
    systemctl --user start cosmic-comp-traffic-session.target >>"$log" 2>&1

    # Both are D-Bus activated and may still be running with the previous
    # session's WAYLAND_DISPLAY (the cosmic backend has no PartOf=, so it
    # survives logout): restarting them costs ~100 ms and avoids a stale
    # socket. `restart`, not `try-restart`: when the previous compositor died
    # the backend usually exited too, and try-restart ignores failed units —
    # that left the portal without a backend for the whole session. Only the
    # cosmic backend: the gtk/gnome/wlr ones do not match UseIn=COSMIC and are
    # never selected in this session.
    for svc in xdg-desktop-portal.service \
        org.freedesktop.impl.portal.desktop.cosmic.service; do
        systemctl --user --no-block restart "$svc" 2>/dev/null
    done

    # No --daemon: that double-forks (ppid 1), so "$!" would point at a dead
    # parent and the cleanup kill would be a no-op. Foreground keeps the pid
    # meaningful and lets everything Noctalia spawns stay in its cgroup.
    noctalia >>"$log" 2>&1 &
    noctalia_pid=$!
else
    echo "cosmic-comp-traffic: compositor socket not found, not starting Noctalia" >>"$log"
    noctalia_pid=""
fi

wait "$comp_pid"
status=$?

cleanup
exit "$status"
