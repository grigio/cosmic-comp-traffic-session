# Runs after a fresh install: make this the session gtkgreet preselects.
# On upgrade the config is left alone, so a deliberate switch to another session
# is not undone by every package update.
post_install() {
  if [ ! -x /usr/bin/cosmalia-session-default ]; then
    return 0
  fi

  if /usr/bin/cosmalia-session-default >/dev/null 2>&1; then
    cat <<'EOF'
Cosmalia (cosmalia-session) is now the greeter default: the -c argument of
/etc/greetd/config.toml was rewritten (previous file kept next to it as
config.toml.bak.<timestamp>).

It takes effect at the next greetd start: a reboot, or
`systemctl restart greetd` while logged out (restarting it from inside a
session ends that session).
EOF
  else
    cat <<'EOF'
Could not preselect the session automatically: /etc/greetd/config.toml is
missing or does not run `gtkgreet -c`. Set it by hand with:

  sudo cosmalia-session-default

The session is selectable from the greeter either way.
EOF
  fi
}

post_upgrade() {
  cat <<'EOF'
The greeter default was left as it is. To make this session the preselected one
again:

  sudo cosmalia-session-default
EOF
}

pre_remove() {
  cat <<'EOF'
If this session is the greeter default, point /etc/greetd/config.toml at another
command first, otherwise the greeter will try to log into a missing session:

  sudo cp -a /etc/greetd/config.toml.bak.<timestamp> /etc/greetd/config.toml
EOF
}
